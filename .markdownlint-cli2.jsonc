{
  "config": {
    "MD013": false, // long lines are fine in prose and tables
    "MD024": false, // changelog and eval files repeat headings
    "MD025": false, // templates hold more than one H1
    "MD031": false, // compact fenced blocks inside lists
    "MD032": false, // compact lists under a label line
    "MD033": false, // inline HTML in README badges
    "MD041": false, // files start with front matter
    "MD047": false // .editorconfig exempts Markdown from the final newline
  },
  "ignores": ["node_modules/", "package-lock.json", ".husky/_/", ".remember/", ".claude/prompts/", "evals/results/"]
}
