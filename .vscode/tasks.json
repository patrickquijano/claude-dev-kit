{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "problemMatcher": []
    },
    {
      "label": "lint: eslint",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "eslint", ".", "--max-warnings", "0"],
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "lint: markdownlint",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "markdownlint-cli2", { "value": "**/*.md", "quoting": "strong" }],
      "problemMatcher": []
    },
    {
      "label": "lint: yamllint",
      "type": "shell",
      "command": "yamllint",
      "args": ["--strict", "."],
      "problemMatcher": []
    },
    {
      "label": "lint: yamlfmt",
      "type": "shell",
      "command": "yamlfmt",
      "args": ["-lint", "."],
      "problemMatcher": []
    },
    {
      "label": "lint: prettier",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "prettier", "--check", "."],
      "problemMatcher": []
    },
    {
      "label": "format: prettier",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "prettier", "--write", "."],
      "problemMatcher": []
    },
    {
      "label": "format: yamlfmt",
      "type": "shell",
      "command": "yamlfmt",
      "args": ["."],
      "problemMatcher": []
    },
    {
      "label": "format: markdownlint",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "markdownlint-cli2", "--fix", { "value": "**/*.md", "quoting": "strong" }],
      "problemMatcher": []
    },
    {
      "label": "compress: caveman",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "dir=\"$(jq -r '.plugins[\"caveman@caveman\"][] | select(.scope==\"user\") | .installPath' ~/.claude/plugins/installed_plugins.json)/skills/caveman-compress\"; [ -f \"$dir/scripts/__main__.py\" ] || { echo \"caveman-compress skill not found: $dir\" >&2; exit 1; }; fail=0; for f in \"$PWD/CLAUDE.md\" \"$PWD\"/.claude/rules/*.md; do (cd \"$dir\" && python3 -m scripts \"$f\") || fail=1; done; npm run format; exit $fail"
      ],
      "problemMatcher": []
    },
    {
      "label": "validate: plugin",
      "type": "shell",
      "command": "claude",
      "args": ["plugin", "validate", "--strict", "."],
      "problemMatcher": []
    }
  ]
}
