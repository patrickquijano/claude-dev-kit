{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "problemMatcher": []
    },
    {
      "label": "lint: eslint",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "eslint", ".", "--max-warnings", "0"],
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "lint: markdownlint",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "markdownlint-cli2", { "value": "**/*.md", "quoting": "strong" }],
      "problemMatcher": []
    },
    {
      "label": "lint: yamllint",
      "type": "shell",
      "command": "yamllint",
      "args": ["--strict", "."],
      "problemMatcher": []
    },
    {
      "label": "lint: yamlfmt",
      "type": "shell",
      "command": "yamlfmt",
      "args": ["-lint", "."],
      "problemMatcher": []
    },
    {
      "label": "lint: prettier",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "prettier", "--check", "."],
      "problemMatcher": []
    },
    {
      "label": "format: prettier",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "prettier", "--write", "."],
      "problemMatcher": []
    },
    {
      "label": "format: yamlfmt",
      "type": "shell",
      "command": "yamlfmt",
      "args": ["."],
      "problemMatcher": []
    },
    {
      "label": "format: markdownlint",
      "type": "shell",
      "command": "npx",
      "args": ["--no-install", "markdownlint-cli2", "--fix", { "value": "**/*.md", "quoting": "strong" }],
      "problemMatcher": []
    },
    {
      "label": "validate: plugin",
      "type": "shell",
      "command": "claude",
      "args": ["plugin", "validate", "--strict", "."],
      "problemMatcher": []
    }
  ]
}
