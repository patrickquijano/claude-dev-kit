{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/release-check.mjs\" hook",
            "timeout": 120,
            "statusMessage": "Checking changelog and version",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/release-check.mjs\" hook",
            "timeout": 120,
            "statusMessage": "Checking changelog and version",
            "if": "Bash(glab *)"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_gitlab_gitlab__save_merge_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/release-check.mjs\" hook",
            "timeout": 120,
            "statusMessage": "Checking changelog and version"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/plugin-validate.mjs\"",
            "timeout": 120,
            "statusMessage": "Validating plugin"
          }
        ]
      }
    ]
  }
}
