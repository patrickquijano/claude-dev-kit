{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/version-bump.mjs\"",
            "timeout": 180,
            "onFailure": "block",
            "statusMessage": "Checking plugin version",
            "if": "Bash(gh pr create *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/version-bump.mjs\"",
            "timeout": 180,
            "onFailure": "block",
            "statusMessage": "Checking plugin version",
            "if": "Bash(glab mr create *)"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_gitlab_gitlab__save_merge_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/version-bump.mjs\"",
            "timeout": 180,
            "onFailure": "block",
            "statusMessage": "Checking plugin version"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/plugin-validate.mjs\"",
            "timeout": 120,
            "statusMessage": "Validating plugin"
          }
        ]
      }
    ]
  }
}
