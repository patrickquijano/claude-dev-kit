{
  "name": "cdk",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0 && markdownlint-cli2 \"**/*.md\" && yamllint --strict . && yamlfmt -lint . && prettier --check .",
    "format": "prettier --write . && yamlfmt . && markdownlint-cli2 --fix \"**/*.md\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2"
  }
}
