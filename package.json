{
  "name": "cdk",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0 && markdownlint-cli2 \"**/*.md\" && yamllint --strict . && yamlfmt -lint . && prettier --check .",
    "format": "prettier --write . && yamlfmt . && markdownlint-cli2 --fix \"**/*.md\"",
    "test": "npm run test:unit && npm run test:integration",
    "audit": "audit-ci --config audit-ci.jsonc",
    "prepare": "husky",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\" \"tests/unit/.claude/**/*.test.mjs\" \"tests/unit/.husky/**/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/**/*.test.mjs\" \"tests/integration/.claude/**/*.test.mjs\" \"tests/integration/.husky/**/*.test.mjs\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "audit-ci": "^7.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2"
  },
  "engines": {
    "node": ">=22"
  }
}
