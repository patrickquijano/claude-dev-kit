{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs\"",
            "timeout": 20,
            "statusMessage": "Loading session context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-tool-use.mjs\"",
            "timeout": 120,
            "statusMessage": "Checking git safety and release",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-tool-use.mjs\"",
            "timeout": 120,
            "statusMessage": "Checking git safety and release",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-tool-use.mjs\"",
            "timeout": 120,
            "statusMessage": "Checking git safety and release",
            "if": "Bash(glab *)"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-tool-use.mjs\"",
            "timeout": 120,
            "statusMessage": "Checking git safety and release",
            "if": "Bash(claude *)"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_gitlab_gitlab__save_merge_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-tool-use.mjs\"",
            "timeout": 120,
            "statusMessage": "Checking git safety and release"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/user-prompt-submit.mjs\"",
            "timeout": 15,
            "statusMessage": "Preparing prompt context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-tool-use.mjs\"",
            "timeout": 300,
            "statusMessage": "Formatting and linting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop.mjs\"",
            "timeout": 600,
            "statusMessage": "Formatting and linting repo"
          }
        ]
      }
    ]
  }
}
